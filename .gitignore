# Terraform / OpenTofu. terraform.tfstate itself is committed, encrypted
# with OpenTofu state encryption (see scripts/lib.sh).
.terraform/
*.tfstate.backup
*.tfstate.*.backup
*.auto.tfvars.json
terraform.tfvars
crash.log

# Nix
result
result-*
.direnv/

# Never commit plaintext keys
*.pem
*.key
!secrets/*.enc

# Python
__pycache__/
